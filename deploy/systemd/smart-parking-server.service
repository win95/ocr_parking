[Unit]
Description=Smart Parking Analytics (server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the account that owns the repo. Change User/Group if needed.
User=ubuntu
Group=ubuntu
WorkingDirectory=%h/ocr_parking
Environment=SMART_PARKING_CONFIG=%h/ocr_parking/configs/deploy/server.local.yaml
Environment=PYTHONUNBUFFERED=1
# Optional: SMART_PARKING_INSPECTOR_TOKEN=... in this file (chmod 600).
EnvironmentFile=-/etc/smart-parking/server.env
ExecStart=%h/ocr_parking/.venv/bin/python -m smart_parking
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
